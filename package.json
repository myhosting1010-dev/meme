{
  "name": "tom-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/unit/*.test.js",
    "test:auth": "node --test tests/integration/auth.test.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:traders": "node scripts/seed-traders.js",
    "migrate:wallets": "node scripts/migrate-wallet-fields.js",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "mongoose": "9.11.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3"
  }
}
